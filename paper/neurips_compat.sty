% neurips_compat.sty — local approximation of the official NeurIPS style,
% used only when neurips_2026.sty is absent. Mirrors the official layout:
% 10pt body, Times, 5.5in x 9in text block, 1in side margins.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_compat}[2026/09/14 NeurIPS-compatible fallback style]

\newif\if@final\@finalfalse
\DeclareOption{final}{\@finaltrue}
\DeclareOption{preprint}{\@finaltrue}
\DeclareOption{nonatbib}{}
\ProcessOptions\relax

% (documentclass is set by main.tex; this package only restyles)
\RequirePackage[letterpaper,textwidth=5.5in,textheight=9in,top=1in,left=1in]{geometry}
\RequirePackage{mathptmx}
\RequirePackage{natbib}
\setlength{\parindent}{0.2in}
\setlength{\parskip}{0pt}
\pagestyle{plain}

% Section heading sizes per NeurIPS style
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection.}{0.5em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection.}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection.}{0.5em}{}
\titlespacing*{\section}{0pt}{12pt plus 2pt minus 2pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt plus 2pt minus 2pt}{4pt}

\renewcommand{\maketitle}{%
  \begin{center}
    {\Large\bfseries \@title \par}
    \vskip 0.25in
    {\normalsize \@author \par}
    \vskip 0.15in
  \end{center}
  \vskip 0.2in
}
\endinput
